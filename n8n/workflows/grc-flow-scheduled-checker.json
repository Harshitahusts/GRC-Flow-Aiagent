{
  "name": "GRC-Flow · scheduled checker",
  "nodes": [
    {
      "id": "3d5788a7-1361-4e36-873e-a22aadd6591b",
      "name": "Every 15 min: health",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "3b4bfec0-b781-4242-ae21-49c6b1cb6c68",
      "name": "Sign health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.GRC_FLOW_WEBHOOK_SECRET;\nconst body = JSON.stringify({ action: 'health' });\nconst ts = Math.floor(Date.now() / 1000).toString();\nconst sig = 'sha256=' + crypto.createHmac('sha256', secret).update(ts + '.' + body).digest('hex');\nreturn [{ json: { body, ts, sig } }];"
      }
    },
    {
      "id": "1aacf740-f2c0-4fec-b73d-082b7072dbca",
      "name": "Run health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GRC_FLOW_API_URL }}/v1/hooks/n8n/checker",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-grc-timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "x-grc-signature",
              "value": "={{ $json.sig }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "df29e509-b50b-4ec4-b9e6-9bac37b95f1a",
      "name": "Daily 06:00: canary",
