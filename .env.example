# Copy to .env. Every service is optional locally: leave a block empty and GRC-Flow
# uses a local stand-in (SQLite, in-memory index/queue, log-only errors).
GRC_FLOW_ENV=development            # production refuses to start with anything missing

# Claude (fact extraction). Or `ant auth login` instead of a key.
ANTHROPIC_API_KEY=
GRC_FLOW_MODEL=claude-opus-5-5
GRC_FLOW_EFFORT=high
# GRC_FLOW_AI_MODE=offline          # keyword stand-in, never in production

# Supabase: Project Settings > Database > Connection string (transaction pooler, port 6543)
SUPABASE_DB_URL=

# Pinecone: index with integrated embedding (created by `grc-flow rag-init`)
PINECONE_API_KEY=
PINECONE_INDEX=grc-dpdpa
PINECONE_NAMESPACE=dpdpa-corpus
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=multilingual-e5-large

# Upstash Redis: database > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry: project > Client Keys (DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Clerk: the Frontend API URL (Clerk dashboard > API keys), and the site origins allowed
# to call this API (comma-separated). GRC_FLOW_AUTH=dev only for local work.
GRC_FLOW_AUTH=clerk
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=https://app.example.com

# n8n: shared HMAC secret (openssl rand -hex 32) and the events-router webhook URL
N8N_WEBHOOK_SECRET=
N8N_OUTBOUND_URL=

# Corpus folder (manifest.json + the gazette PDFs, GRC-Ai format)
GRC_FLOW_CORPUS_DIR=corpus
